<!doctype html>
<html lang="fr">
<head>
    <script>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#00095B">
    <title>{% block title %}La Roue Ford{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Inscrivez-vous, faites tourner la roue et tentez de gagner un cadeau Ford.{% endblock %}">
    <link rel="icon" type="image/x-icon" href="{{ asset('assets/imgs/favicon.ico') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/roue-ford.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="page {% block body_class %}{% endblock %}">
<a class="skip-link" href="#contenu">Aller au contenu</a>

<header class="site-header">
    <div class="shell site-header__inner">
        <a class="site-header__brand" href="{{ path('app_home') }}">
            <img src="{{ asset('assets/imgs/ReadySetFord_White_v1.png') }}" alt="Ready Set Ford" class="site-header__logo">
        </a>
        {% block header_aside %}{% endblock %}
    </div>
</header>

<main id="contenu" class="site-main">
    {% include 'game/_flashes.html.twig' %}
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="shell">
        <p>© {{ 'now'|date('Y') }} Ford Tunisie. Tous droits réservés.</p>
    </div>
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>
