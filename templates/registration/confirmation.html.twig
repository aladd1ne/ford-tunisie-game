{% extends 'base.html.twig' %}

{% block title %}Inscription confirmée — La Roue Ford{% endblock %}
{% block body_class %}page--form{% endblock %}

{% block content %}
    <section class="auth-hero">
        <img
            class="auth-hero__media"
            src="{{ asset('assets/imgs/hero.jpg') }}"
            srcset="{{ asset('assets/imgs/hero-sm.jpg') }} 900w, {{ asset('assets/imgs/hero-md.jpg') }} 1400w, {{ asset('assets/imgs/hero.jpg') }} 2200w"
            sizes="100vw"
            alt=""
            aria-hidden="true"
        >
        <div class="auth-hero__veil" aria-hidden="true"></div>

        <div class="shell panel-wrap">
            <div class="panel">
                <h1 class="panel__title">Inscription confirmée, {{ firstName }} !</h1>
                <p class="panel__lead">
                    Présentez-vous à l’accueil : l’équipe vous donnera accès à La Roue Ford pour tenter de gagner un cadeau.
                </p>

                <div class="form__actions">
                    <a class="btn btn--primary btn--lg" href="{{ path('app_home') }}">Terminer</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
