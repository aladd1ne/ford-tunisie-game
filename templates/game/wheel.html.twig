{% extends 'base.html.twig' %}

{% set spin_token = csrf_token(constant('App\\Controller\\public\\GameController::SPIN_CSRF_TOKEN_ID')) %}

{% block title %}Faites tourner La Roue Ford{% endblock %}
{% block body_class %}page--game{% endblock %}

{% block content %}
    {# Englobe la roue ET la carte de résultat : en plein écran, seuls les
       descendants de l'élément plein écran restent affichés, il faut donc
       que le résultat (et les confettis) y restent inclus. #}
    <div id="roue-scene">
        <section class="shell game">
            <button type="button" class="fullscreen-btn" id="roue-plein-ecran" aria-pressed="false" hidden>
                <svg class="fullscreen-btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path id="roue-plein-ecran-icone" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
                          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="fullscreen-btn__label" id="roue-plein-ecran-libelle">Plein écran</span>
            </button>

            {# Écran public : le joueur est désigné depuis le back-office. Sans
               joueur autorisé, la roue attend (et interroge le serveur). #}
            <p class="eyebrow" id="roue-joueur">
                {{ player is not null ? 'Bonjour ' ~ player.firstName : 'En attente du prochain joueur' }}
            </p>
            <h1 class="game__title">Faites tourner La Roue Ford</h1>

            <div class="wheel-stage">
                <div class="wheel-pointer" aria-hidden="true"></div>
                <div class="wheel" id="roue" data-spinning="false" role="img"
                     aria-label="Roue des lots La Roue Ford"></div>
                <div class="wheel-hub" aria-hidden="true">
                    <img src="{{ asset('assets/imgs/ReadySetFord_White_v1.png') }}" alt="">
                </div>
            </div>

            <div class="game__actions">
                <button type="button" class="btn btn--primary btn--lg" id="roue-bouton"
                        {% if player is null %}disabled{% endif %}>
                    Faire tourner la roue
                </button>
                <p class="game__hint" id="roue-attente" {% if player is not null %}hidden{% endif %}>
                    Présentez-vous à l’accueil pour être autorisé à jouer.
                </p>
                <p class="game__error" id="roue-erreur" role="alert" hidden></p>
                <noscript>
                    <p class="alert alert--warning">
                        Activez JavaScript pour faire tourner la roue et découvrir votre résultat.
                    </p>
                </noscript>
            </div>

            <details class="legend">
                <summary class="legend__summary">Les lots en jeu</summary>
                <ul class="legend__list">
                    {% for prize in prizes %}
                        <li class="legend__item" data-prize-uuid="{{ prize.uuid }}">
                            <span class="legend__dot" style="background: {{ prize.color|default('#066FEF') }}"></span>
                            <span class="legend__name">{{ prize.name }}</span>
                            {% if prize.hasLimitedStock %}
                                <span class="legend__stock{{ prize.outOfStock ? ' legend__stock--empty' }}" data-legend-stock>
                                    {{- prize.outOfStock ? 'Épuisé' : prize.remainingStock ~ ' restant' ~ (prize.remainingStock > 1 ? 's') -}}
                                </span>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="legend__item">Aucun lot n’est disponible pour le moment.</li>
                    {% endfor %}
                </ul>
            </details>
        </section>

        <div class="result" id="roue-resultat" role="dialog" aria-modal="true" aria-labelledby="roue-resultat-titre" hidden>
            <div class="result__card" id="roue-resultat-carte">
                <p class="result__badge" id="roue-resultat-badge"></p>
                <h2 class="result__title" id="roue-resultat-titre"></h2>
                <p class="result__detail" id="roue-resultat-detail" hidden></p>
                <p class="result__thanks" id="roue-resultat-merci" hidden>
                    Merci d’avoir participé à La Roue Ford !
                </p>

                <div class="result__actions" id="roue-resultat-actions">
                    {# Chaque participant ne joue qu'une fois : « Terminer » referme
                       le résultat et remet la roue en attente du joueur suivant. #}
                    <button type="button" class="btn btn--primary btn--lg" id="roue-terminer">Terminer</button>
                </div>
            </div>
        </div>

        <canvas class="confetti-canvas" id="confetti-canvas" aria-hidden="true" hidden></canvas>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="application/json" id="roue-data">
        {{ {
            segments: segments,
            spinUrl: path('app_game_spin'),
            playerUrl: path('app_game_player'),
            csrfToken: spin_token,
            player: player
        }|json_encode|raw }}
    </script>
    <script src="{{ asset('assets/js/vendor/confetti.browser.min.js') }}" defer></script>
    <script src="{{ asset('assets/js/roue-ford.js') }}" defer></script>
{% endblock %}
