{% extends 'base.html.twig' %}

{% block title %}Inscription confirmée ! — La Roue Ford{% endblock %}
{% block body_class %}page--form{% endblock %}

{% block content %}
    <section class="shell panel-wrap">
        <div class="panel panel--center">
            <p class="eyebrow">Étape 2 sur 2</p>
            <h1 class="panel__title">Inscription confirmée !</h1>
            <p class="panel__lead panel__lead--strong">
                Merci {{ participant.firstName }}. Vous pouvez maintenant faire tourner La Roue Ford et découvrir votre résultat.
            </p>
            <a class="btn btn--primary btn--lg" href="{{ path('app_game') }}">Faire tourner la roue</a>
        </div>
    </section>
{% endblock %}
